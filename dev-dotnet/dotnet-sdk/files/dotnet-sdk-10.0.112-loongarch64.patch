+#error Define HARDWARE_INTRINSIC before including this file
+#endif
+/*****************************************************************************/
+
+// clang-format off
+
+#ifdef FEATURE_HW_INTRINSICS
+
+////  Part-I: LoongArch64Base: HW-Intrinsic
+// **************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************
+//                 ISA            Function name                                          SIMD size  Number of arguments                                                                                                                Instructions                                                                                                            Category                           Flags
+//                                                                                                              {TYP_BYTE,               TYP_UBYTE,              TYP_SHORT,              TYP_USHORT,             TYP_INT,                TYP_UINT,               TYP_LONG,               TYP_ULONG,              TYP_FLOAT,              TYP_DOUBLE}
+// **************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************************
+#define FIRST_NI_LoongArch64Base NI_LoongArch64Base_CyclicRedundancyCheckCastagnoli
+HARDWARE_INTRINSIC(LoongArch64Base,      CyclicRedundancyCheckCastagnoli,                               0,      2,     {INS_invalid,        INS_crcc_w_b_w,     INS_invalid,        INS_crcc_w_h_w,     INS_invalid,        INS_crcc_w_w_w,     INS_invalid,        INS_crcc_w_d_w,     INS_invalid,        INS_invalid},       HW_Category_Scalar,                HW_Flag_BaseTypeFromSecondArg|HW_Flag_NoFloatingPointUsed|HW_Flag_SpecialCodeGen)
+HARDWARE_INTRINSIC(LoongArch64Base,      CyclicRedundancyCheckIEEE8023,                                 0,      2,     {INS_invalid,        INS_crc_w_b_w,      INS_invalid,        INS_crc_w_h_w,      INS_invalid,        INS_crc_w_w_w,      INS_invalid,        INS_crc_w_d_w,      INS_invalid,        INS_invalid},       HW_Category_Scalar,                HW_Flag_BaseTypeFromSecondArg|HW_Flag_NoFloatingPointUsed|HW_Flag_SpecialCodeGen)
+HARDWARE_INTRINSIC(LoongArch64Base,      FloatClass,                                                    0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_fclass_s,       INS_fclass_d},      HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      FloatCopySign,                                                 0,      2,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_fcopysign_s,    INS_fcopysign_d},   HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      FloatLogarithm2,                                               0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_flogb_s,        INS_flogb_d},       HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      FloatScaleBinary,                                              0,      2,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_fscaleb_s,      INS_fscaleb_d},     HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,           FusedMultiplyAdd,                                         0,      3,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_fmadd_s,        INS_fmadd_d},       HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      LeadingSignCount,                                              0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_clo_w,          INS_clo_w,          INS_clo_d,          INS_clo_d,          INS_invalid,        INS_invalid},       HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg|HW_Flag_NoFloatingPointUsed)
+HARDWARE_INTRINSIC(LoongArch64Base,      LeadingZeroCount,                                              0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_clz_w,          INS_clz_w,          INS_clz_d,          INS_clz_d,          INS_invalid,        INS_invalid},       HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg|HW_Flag_NoFloatingPointUsed)
+HARDWARE_INTRINSIC(LoongArch64Base,      MultiplyHigh,                                                  0,      2,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_mulh_w,         INS_mulh_wu,        INS_mulh_d,         INS_mulh_du,        INS_invalid,        INS_invalid},       HW_Category_Scalar,                HW_Flag_NoFloatingPointUsed)
+HARDWARE_INTRINSIC(LoongArch64Base,      Reciprocal,                                                    0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_frecip_s,       INS_frecip_d},      HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      ReciprocalEstimate,                                            0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_frecipe_s,      INS_frecipe_d},     HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      ReciprocalSqrt,                                                0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_frsqrt_s,       INS_frsqrt_d},      HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
+HARDWARE_INTRINSIC(LoongArch64Base,      ReciprocalSqrtEstimate,                                        0,      1,     {INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_frsqrte_s,      INS_frsqrte_d},     HW_Category_Scalar,                HW_Flag_BaseTypeFromFirstArg)
