+HARDWARE_INTRINSIC(LASX,          SubtractSaturate,                                             32,      2,     {INS_xvssub_b,       INS_xvssub_bu,      INS_xvssub_h,       INS_xvssub_hu,      INS_xvssub_w,       INS_xvssub_wu,      INS_xvssub_d,       INS_xvssub_du,      INS_invalid,        INS_invalid},       HW_Category_3R,                    HW_Flag_NoFlag)
+HARDWARE_INTRINSIC(LASX,          SubtractWideningLower,                                        32,      2,     {INS_xvsubwev_h_b,   INS_xvsubwev_h_bu,  INS_xvsubwev_w_h,   INS_xvsubwev_w_hu,  INS_xvsubwev_d_w,   INS_xvsubwev_d_wu,  INS_xvsubwev_q_d,   INS_xvsubwev_q_du,  INS_invalid,        INS_invalid},       HW_Category_SIMD,                  HW_Flag_NoFlag)
+HARDWARE_INTRINSIC(LASX,          SubtractWideningUpper,                                        32,      2,     {INS_xvsubwod_h_b,   INS_xvsubwod_h_bu,  INS_xvsubwod_w_h,   INS_xvsubwod_w_hu,  INS_xvsubwod_d_w,   INS_xvsubwod_d_wu,  INS_xvsubwod_q_d,   INS_xvsubwod_q_du,  INS_invalid,        INS_invalid},       HW_Category_SIMD,                  HW_Flag_NoFlag)
+HARDWARE_INTRINSIC(LASX,           VectorTableLookup,                                           32,      3,     {INS_xvshuf_b,       INS_xvshuf_b,       INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid,        INS_invalid},       HW_Category_SIMD,                  HW_Flag_SpecialImport|HW_Flag_SpecialCodeGen)
+HARDWARE_INTRINSIC(LASX,           VectorTableLookup1,                                          32,      3,     {INS_invalid,        INS_invalid,        INS_xvshuf_h,       INS_xvshuf_h,       INS_xvshuf_w,       INS_xvshuf_w,       INS_xvshuf_d,       INS_xvshuf_d,       INS_xvshuf_w,       INS_xvshuf_d},      HW_Category_SIMD,                  HW_Flag_SpecialImport|HW_Flag_SpecialCodeGen)
+HARDWARE_INTRINSIC(LASX,          Xor,                                                          32,      2,     {INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v,        INS_xvxor_v},       HW_Category_3R,                    HW_Flag_Commutative)
+HARDWARE_INTRINSIC(LASX,          ZeroExtendWideningLower,                                      32,      2,     {INS_xvsllwil_hu_bu, INS_xvsllwil_hu_bu, INS_xvsllwil_wu_hu, INS_xvsllwil_wu_hu, INS_xvsllwil_du_wu, INS_xvsllwil_du_wu, INS_xvextl_qu_du,   INS_xvextl_qu_du,   INS_invalid,        INS_invalid},       HW_Category_2R_1I,                 HW_Flag_BaseTypeFromFirstArg|HW_Flag_HasImmediateOperand|HW_Flag_MaybeCnsIntOrISrcContained)
+HARDWARE_INTRINSIC(LASX,          ZeroExtendWideningUpper,                                      32,      1,     {INS_xvexth_hu_bu,   INS_xvexth_hu_bu,   INS_xvexth_wu_hu,   INS_xvexth_wu_hu,   INS_xvexth_du_wu,   INS_xvexth_du_wu,   INS_xvexth_qu_du,   INS_xvexth_qu_du,   INS_invalid,        INS_invalid},       HW_Category_2R,                    HW_Flag_BaseTypeFromFirstArg)
+#define LAST_NI_LASX         NI_LASX_ZeroExtendWideningUpper
+
