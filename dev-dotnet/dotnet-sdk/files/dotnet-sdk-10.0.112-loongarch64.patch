+//-----------------------------------------------------------------------------------
+// emitStoreSimd12ToLclOffset: store SIMD12 value from dataReg to varNum+offset.
+//
+// Arguments:
+//     varNum         - the variable on the stack to use as a base;
+//     offset         - the offset from the varNum;
+//     dataReg        - the src reg with SIMD12 value;
+//     tmpRegProvider - a tree to grab a tmp reg from if needed.
+//
+void emitter::emitStoreSimd12ToLclOffset(unsigned varNum, unsigned offset, regNumber dataReg, GenTree* tmpRegProvider)
+{
+    assert(varNum != BAD_VAR_NUM);
+    assert(isVectorRegister(dataReg));
+
+    // store lower 8 bytes
+    emitIns_S_R(INS_fst_d, EA_8BYTE, dataReg, varNum, offset);
+
+    bool FPbased;
+    int  base = emitComp->lvaFrameAddress(varNum, &FPbased);
+    int  imm  = base + offset + 8;
+
+    if (imm < 512 && imm >= -512)
+    {
+        regNumber reg1 = FPbased ? REG_FPBASE : REG_SPBASE;
+        emitIns_R_R_I_I(INS_vstelm_w, EA_4BYTE, dataReg, reg1, (imm >> 2), 2);
+    }
+    else if (codeGen->internalRegisters.Count(tmpRegProvider) == 0)
+    {
+        // We don't have temp regs - let's do two shuffles then
+
+        // [0,1,2,3] -> [2,3,0,1]
+        emitIns_R_R_I(INS_vpermi_w, EA_16BYTE, dataReg, dataReg, 0x4e);
+
+        //  Store upper 4 bytes
+        emitIns_S_R(INS_fst_s, EA_4BYTE, dataReg, varNum, offset + 8);
+
+        // Restore dataReg to its previous state: [2,3,0,1] -> [0,1,2,3]
+        emitIns_R_R_I(INS_vpermi_w, EA_16BYTE, dataReg, dataReg, 0x4e);
+
+    }
+    else
+    {
+        // Extract upper 4-bytes from data
+        regNumber tmpReg = codeGen->internalRegisters.Extract(tmpRegProvider);
+        assert(isFloatReg(tmpReg));
+        emitIns_R_R_I(INS_xvpickve_w, EA_4BYTE, tmpReg, dataReg, 2);
+        emitIns_S_R(INS_fst_s, EA_4BYTE, tmpReg, varNum, offset + 8);
+    }
+}
