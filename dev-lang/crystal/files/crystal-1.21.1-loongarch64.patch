+  macro def_syscall(name, return_type, *args)
+    @[::AlwaysInline]
+    def self.{{name.id}}({{args.splat}}) : {{return_type}}
+      ret = uninitialized {{return_type}}
+
+      {% if args.size == 0 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 1 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 2 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}}), "{$r5}"({{args[1].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 3 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}}), "{$r5}"({{args[1].var.id}}),
+                       "{$r6}"({{args[2].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 4 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}}), "{$r5}"({{args[1].var.id}}),
+                       "{$r6}"({{args[2].var.id}}), "{$r7}"({{args[3].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 5 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}}), "{$r5}"({{args[1].var.id}}),
+                       "{$r6}"({{args[2].var.id}}), "{$r7}"({{args[3].var.id}}), "{$r8}"({{args[4].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% elsif args.size == 6 %}
+        asm("syscall 0" : "={$r4}"(ret)
+                     : "{$r11}"(::Syscall::Code::{{name.stringify.upcase.id}}), "{$r4}"({{args[0].var.id}}), "{$r5}"({{args[1].var.id}}),
+                       "{$r6}"({{args[2].var.id}}), "{$r7}"({{args[3].var.id}}), "{$r8}"({{args[4].var.id}}), "{$r9}"({{args[5].var.id}})
+                     : "$r12", "$r13", "$r14", "$r15", "$r16", "$r17", "$r18", "$r19", "$r20", "memory"
+                     : "volatile")
+      {% else %}
+        {% raise "Not supported number of arguments for syscall" %}
+      {% end %}
+
+      ret
+    end
+  end
+end
