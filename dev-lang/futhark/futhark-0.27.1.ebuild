pkg_postinst() {
	elog "The C backend needs a C compiler. Optional backends also need:"
	elog "  OpenCL: virtual/opencl and OpenCL headers"
	elog "  CUDA:   NVIDIA CUDA toolkit"
	elog "  HIP:    ROCm"
	elog "  Python: Python, plus pyopencl for the PyOpenCL backend"
}
