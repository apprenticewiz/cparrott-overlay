EAPI=8

# Dependency list generated by hackport 0.9.1.0, then trimmed to the
# library/executable stanzas: the test-suite and benchmark deps (criterion,
# tasty*, lsp-test, QuickCheck) are not built here.

# No "lib": futhark is an end-user compiler, so only the executable is
# installed and nothing is registered in the GHC package database.
CABAL_FEATURES=""
inherit haskell-cabal

DESCRIPTION="Data-parallel functional array language"
HOMEPAGE="https://futhark-lang.org/"
SRC_URI="https://hackage.haskell.org/package/${P}/${P}.tar.gz"

LICENSE="ISC"
SLOT="0"
KEYWORDS="~arm64"

RDEPEND=">=dev-haskell/aeson-2.0.0.0:=
