+
+#if LLVM_VERSION_MAJOR >= 20
+/*
+ * On AArch64, the return address is saved in one of the callee-save
+ * slots, and which one depends on the other registers the function
+ * saves.  Record it while the MachineFunction is still alive.
+ */
+class RetOffsetRecorder : public AsmPrinterHandler {
+	DenseMap<const Function *, uint64_t> &RetOffsets;
+public:
+	RetOffsetRecorder(DenseMap<const Function *, uint64_t> &r)
+		: RetOffsets(r) {}
+	void endModule() override {}
+	void beginFunction(const MachineFunction *) override {}
+	void endFunction(const MachineFunction *mf) override {
+		if (!mf->getTarget().getTargetTriple().isAArch64())
+			return;
+		const MachineFrameInfo &mfi = mf->getFrameInfo();
+		if (!mfi.isCalleeSavedInfoValid())
+			return;
+		MCRegister ra = mf->getSubtarget().getRegisterInfo()
+			->getRARegister();
+		for (const CalleeSavedInfo &cs : mfi.getCalleeSavedInfo()) {
+			if (cs.getReg() != ra || cs.isSpilledToReg())
+				continue;
+			int64_t offset = mfi.getObjectOffset(cs.getFrameIdx());
+			if (offset >= 0 || offset % 8 != 0)
+				report_fatal_error("SML#: unexpected return address slot");
+			RetOffsets[&mf->getFunction()] = -offset / 8;
+		}
+	}
+};
+#endif
 }
 
