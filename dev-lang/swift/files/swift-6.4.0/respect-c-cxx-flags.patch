   endif()
 
+  separate_arguments(cxxflags NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
+  foreach(flag IN LISTS cxxflags)
+    list(APPEND swift_compile_options "-Xcc" "${flag}")
+  endforeach()
+
   set(all_obj_files)
   set(all_module_targets)
   set(all_module_files)
